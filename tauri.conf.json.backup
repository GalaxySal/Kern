{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420"
  },
  "package": {
    "productName": "kern",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "identifier": "com.kern.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.png",
        "icons/icon.ico"
      ]
    },
    "windows": [
      {
        "title": "Kern Editor",
        "width": 1200,
        "height": 800
      }
    ]
  }
}
