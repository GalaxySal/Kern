{
    "productName": "kern",
    "version": "0.1.0",
    "identifier": "com.kern.editor",
    "build": {
        "beforeDevCommand": "npm run dev --prefix ui",
        "beforeBuildCommand": "npm run build --prefix ui",
        "devUrl": "http://127.0.0.1:5173",
        "frontendDist": "../ui/dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Kern",
                "width": 1024,
                "height": 768,
                "decorations": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/icon.png",
            "icons/icon.ico",
            "icons/icon.icns"
        ]
    }
}