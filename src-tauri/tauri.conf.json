{
    "$schema": "https://schema.tauri.app/config/2.0.0",
    "productName": "kern",
    "version": "0.1.2",
    "identifier": "com.kern.editor",
    "build": {
        "beforeDevCommand": "npm run dev --prefix ui",
        "beforeBuildCommand": "npm run build --prefix ui",
        "devUrl": "http://127.0.0.1:5173",
        "frontendDist": "../ui/dist"
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/icon.png",
            "icons/icon.ico"
        ]
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Kern Editor",
                "width": 1200,
                "height": 800,
                "resizable": true,
                "fullscreen": false,
                "center": true,
                "decorations": true,
                "devtools": true
            },
            {
                "label": "github-oauth",
                "title": "Sign in with GitHub",
                "width": 800,
                "height": 800,
                "center": true,
                "decorations": true,
                "alwaysOnTop": false,
                "hiddenTitle": true,
                "acceptFirstMouse": true,
                "focus": true,
                "devtools": true,
                "visible": false
            }
        ],
        "security": {
            "csp": "default-src 'self' http://localhost:3001 http://localhost:5173 https://*.github.com; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' http://localhost:3001 http://localhost:5173 https://api.github.com https://*.googleapis.com https://api.anthropic.com https://api.openai.com https://api.deepseek.com https://*.supabase.co; frame-src 'self' https://github.com http://localhost:3001 http://localhost:5173; worker-src 'self' blob:;"
        }
    },
    "plugins": {
        "localhost": {
            "port": 9527
        }
    }
}