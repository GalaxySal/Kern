{
    "version": 1,
    "identifier": "allow-all",
    "description": "Allow all custom commands",
    "commands": {
        "allow": [
            "openFile",
            "saveFile",
            "readDir",
            "getViewLines",
            "spawnTerminal",
            "writeToTerminal",
            "resizeTerminal",
            "getGitBranch",
            "openProject",
            "searchFiles",
            "searchContent",
            "watchProject",
            "unwatchProject",
            "listMarketplaceExtensions",
            "listInstalledExtensions",
            "installExtension",
            "uninstallExtension",
            "tailwindScanProject",
            "tailwindStartWatcher",
            "tailwindStopWatcher",
            "streamVibeChat",
            "applyCodeChange",
            "syncSettings"
        ]
    }
}